#!/usr/bin/env bash
# Once per machine: wire Claude Code to this playbook.
#   <config>/CLAUDE.md      gets a marked block importing llms.txt and ways-of-working.md
#   <config>/settings.json  gets a SessionStart hook that runs bin/wake
# <config> is $CLAUDE_CONFIG_DIR, else ~/.claude. Idempotent: rerun after moving the clone.
# settings.json is backed up before any write to it.
set -u

PB="$(cd "$(dirname "$0")/.." && pwd -P)"
CFG="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
MD="$CFG/CLAUDE.md"
SETTINGS="$CFG/settings.json"
mkdir -p "$CFG"

# --- CLAUDE.md: a marked block. HTML comments are stripped before Claude sees the file.
BEGIN='<!-- claude-playbook:begin -->'
END='<!-- claude-playbook:end -->'
block="$BEGIN
@$PB/llms.txt
@$PB/ways-of-working.md
$END"
touch "$MD"
if grep -qF "$BEGIN" "$MD" && grep -qF "$END" "$MD"; then
  python3 - "$MD" "$BEGIN" "$END" "$block" <<'PY'
import sys
path, begin, end, block = sys.argv[1:5]
s = open(path).read()
i, j = s.index(begin), s.index(end) + len(end)
new = s[:i] + block + s[j:]
if new != s:
    open(path, "w").write(new); print(f"{path}: block updated")
else:
    print(f"{path}: block already current")
PY
else
  [ -s "$MD" ] && [ -n "$(tail -c1 "$MD")" ] && echo >> "$MD"
  printf '\n%s\n' "$block" >> "$MD"
  echo "$MD: block appended"
fi

# --- settings.json: merge one SessionStart hook group; replace ours if the path moved.
python3 - "$SETTINGS" "$PB/bin/wake" <<'PY'
import json, os, shutil, sys, time
path, cmd = sys.argv[1:3]
exists = os.path.exists(path) and os.path.getsize(path) > 0
d = json.load(open(path)) if exists else {}
groups = d.setdefault("hooks", {}).setdefault("SessionStart", [])
want = {"matcher": "startup|resume|clear|compact",
        "hooks": [{"type": "command", "command": cmd, "timeout": 15}]}
def ours(g):
    return any(h.get("command", "").endswith("/bin/wake") for h in g.get("hooks", []))
mine = [g for g in groups if ours(g)]
if not mine:
    groups.append(want); msg = "hook added"
elif len(mine) > 1 or mine[0] != want:
    for g in mine: groups.remove(g)
    groups.append(want); msg = "hook updated"
else:
    print(f"{path}: hook already current ({cmd})"); sys.exit(0)
if exists:
    bak = f"{path}.bak-playbook-{time.strftime('%Y%m%d-%H%M%S')}"
    shutil.copy2(path, bak); print(f"{path}: backed up to {bak}")
with open(path, "w") as f:
    json.dump(d, f, indent=2, ensure_ascii=False); f.write("\n")
print(f"{path}: {msg} ({cmd})")
PY

echo "install: done. Verify in a new session anywhere: the first context lines begin with '[playbook]'."
echo "         By hand: $PB/bin/wake </dev/null"
exit 0
